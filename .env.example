# Modelo das variáveis de ambiente do StorySell.
#
# Como usar: copie este arquivo para um arquivo chamado ".env" (na mesma pasta)
# e preencha os valores. O arquivo ".env" NUNCA deve ir para o GitHub
# (o .gitignore já impede isso).

# ---------------------------------------------------------------------------
# Banco de dados (obrigatório)
# ---------------------------------------------------------------------------
# Endereço do banco PostgreSQL no Neon (https://neon.tech).
# No painel do Neon: projeto "storysell" → "Connect" → copie a "connection string".
# Use o banco "dev" no seu computador e um banco "prod" separado na produção.
# Prefira a conexão direta (sem "-pooler" no endereço), que funciona com as migrações.
DATABASE_URL="postgresql://USUARIO:SENHA@HOST.neon.tech/storysell_dev?sslmode=require"

# ---------------------------------------------------------------------------
# Shopify
# ---------------------------------------------------------------------------
# No seu computador, o comando "npm run dev" (Shopify CLI) preenche estas
# variáveis sozinho. Você só precisa preenchê-las na produção (Render, Etapa 12).
#
# Chave do app (Client ID), no painel de parceiro → app → Configuração.
SHOPIFY_API_KEY=
# Segredo do app (Client secret). É SECRETO: nunca compartilhe nem commite.
SHOPIFY_API_SECRET=
# Endereço público do servidor do app (ex.: https://storysell.onrender.com).
SHOPIFY_APP_URL=
# Permissões do app, separadas por vírgula. Igual a "scopes" no shopify.app.toml.
SCOPES=

# Opcional: domínio personalizado da loja, só se necessário.
# SHOP_CUSTOM_DOMAIN=
