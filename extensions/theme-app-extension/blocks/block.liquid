{% assign avg_rating = product.metafields.boilerplate_product_namespace.rating.value | round %}
{% assign plan_status = shop.metafields.boilerplate_shop_namespace.plan_status.value | downcase %}  

{% if plan_status == "active" %}
  <span id="app_content" style="color:{{ block.settings.colour }}">
    {% render 'stars', rating: avg_rating %}
  </span>
{% else %}
  <p>Your app plan is not active. Please upgrade to use this feature.</p>
{% endif %}

<script>
  // This is the demo code to fetch theme settings via app proxy
  const shopDomain = "{{ shop.domain }}", proxyUrl = `https://${shopDomain}/apps/unique-proxy-handle`;
  fetch(`${proxyUrl}/settings`, {
    method: "POST",
    headers: { "Content-Type": "application/json" },
    body: JSON.stringify({ key: "value" })
  })
  .then(res => res.json())
  .then(data => {
    console.log('Theme settings from API:', data.settings);
  });
</script>

{% schema %}
{
  "name": "Star Rating",
  "target": "body",
  "settings": [
    {
      "type": "color",
      "id": "colour",
      "label": "Star Colour",
      "default": "#ff0000"
    }
  ]
}
{% endschema %}
